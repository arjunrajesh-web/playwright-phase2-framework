
name: Playwright Tests

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  test:
    runs-on: ubuntu-latest
    environment: BASE_URL
    timeout-minutes: 30

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Run authentication setup
        run: npx playwright test --project=setup
        env:
          CI: "true"
          BASE_URL: ${{ secrets.BASE_URL }}
          DEMO_USER: ${{ secrets.DEMO_USER }}
          DEMO_PASS: ${{ secrets.DEMO_PASS }}

      - name: Upload login debug screenshot
        if: ${{ failure() }}
        uses: actions/upload-artifact@v4
        with:
          name: login-debug
          path: test-results/after-login.png
          if-no-files-found: ignore

      - name: Verify authentication state file
        run: |
          ls -la auth/
          test -f auth/storageState.json

      - name: Run Playwright tests
        run: npx playwright test --project=chromium
        env:
          CI: "true"
          BASE_URL: ${{ secrets.BASE_URL }}
          DEMO_USER: ${{ secrets.DEMO_USER }}
          DEMO_PASS: ${{ secrets.DEMO_PASS }}

      - name: Upload report
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: playwright-report/
          retention-days: 7
